# ─────────────────────────────────────────────────────────────────────────────
# Perchance Image Generator – environment variables (all optional)
# Copy to .env for local development. On Vercel set them in Project → Settings → Environment Variables,
# on Render in the service's Environment page (the Dockerfile already sets the browser-related ones).
# Full reference: system_rule.md → "Configuration".
# ─────────────────────────────────────────────────────────────────────────────

# Local dev server port (ignored on Vercel)
# PORT=3000

# Browser strategy: auto | local | serverless | remote
#   auto → remote if BROWSER_WS_ENDPOINT is set, serverless on Vercel, otherwise local
# BROWSER_MODE=auto

# Connect to a remote Chromium over CDP instead of launching one (e.g. Browserless / Browserbase / your VM)
# BROWSER_WS_ENDPOINT=wss://example.com/chromium?token=...

# Local only: use a specific Chrome/Chromium binary instead of `npm run browsers:install`
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# HEADLESS=true

# Extra Chromium switches, whitespace-separated (the Docker image sets --disable-dev-shm-usage)
# CHROMIUM_EXTRA_ARGS=--disable-dev-shm-usage

# Route the browser through a proxy (e.g. residential) – helps when Perchance's anti-bot check rejects the server IP
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Replace the "HeadlessChrome" user-agent / client hints with regular Chrome values (recommended)
# SPOOF_CLIENT_HINTS=true

# Time budgets (milliseconds). Keep GENERATION_TIMEOUT_MS below the Vercel maxDuration (300 s).
# GENERATION_TIMEOUT_MS=240000
# PAGE_LOAD_TIMEOUT_MS=45000
# ANTI_BOT_GRACE_MS=45000

# Concurrency guard per function instance (each job runs its own Chromium)
# MAX_CONCURRENT_JOBS=1
# QUEUE_TIMEOUT_MS=60000

# Long-running server (Render / Docker / npm start): after SIGTERM, wait this long for in-flight generations
# SHUTDOWN_TIMEOUT_MS=280000

# Protect /generator with a shared secret (X-API-Key header, Bearer token or ?key=)
# API_KEY=

# CORS origin for the API
# CORS_ORIGIN=*

# Max prompt length (characters)
# MAX_PROMPT_LENGTH=2000
